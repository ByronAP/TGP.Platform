@page "/IgnoredApps"
@model TGP.AdminPortal.Pages.IgnoredApps.IndexModel
@{
    ViewData["Title"] = "Ignored Apps";
}

<div class="card-header" style="background: var(--card-bg); border-radius: 0.75rem 0.75rem 0 0; margin-bottom: 0;">
    <h2>Ignored Applications</h2>
    <div style="display: flex; gap: 1rem; align-items: center;">
        <form method="get" style="display: flex; gap: 0.5rem;">
            <select name="platform" class="form-control form-control-sm" onchange="this.form.submit()">
                <option value="">All Platforms</option>
                <option value="Windows" selected="@(Model.FilterPlatform == "Windows")">Windows</option>
                <option value="MacOS" selected="@(Model.FilterPlatform == "MacOS")">MacOS</option>
                <option value="Linux" selected="@(Model.FilterPlatform == "Linux")">Linux</option>
            </select>
            <select name="category" class="form-control form-control-sm" onchange="this.form.submit()">
                <option value="">All Categories</option>
                <option value="System" selected="@(Model.FilterCategory == "System")">System</option>
                <option value="Runtime" selected="@(Model.FilterCategory == "Runtime")">Runtime</option>
                <option value="Driver" selected="@(Model.FilterCategory == "Driver")">Driver</option>
                <option value="Background" selected="@(Model.FilterCategory == "Background")">Background</option>
            </select>
        </form>
        <a href="/IgnoredApps/Create" class="btn btn-primary btn-sm">+ Add Ignored App</a>
    </div>
</div>

<div class="card" style="border-radius: 0 0 0.75rem 0.75rem;">
    <div class="card-body" style="padding: 0;">
        <table class="table">
            <thead>
                <tr>
                    <th>Process Name</th>
                    <th>Platform</th>
                    <th>Category</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var app in Model.IgnoredApps)
                {
                    <tr>
                        <td>
                            <strong>@app.ProcessName</strong>
                        </td>
                        <td>
                            <span class="badge badge-info">@app.Platform</span>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(app.Category))
                            {
                                <span>@app.Category</span>
                            }
                            else
                            {
                                <span style="color: var(--secondary);">—</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(app.Description))
                            {
                                <small style="color: var(--secondary);">@app.Description</small>
                            }
                            else
                            {
                                <span style="color: var(--secondary);">—</span>
                            }
                        </td>
                        <td>
                            @if (app.IsEnabled)
                            {
                                <span class="badge badge-success">Enabled</span>
                            }
                            else
                            {
                                <span class="badge">Disabled</span>
                            }
                        </td>
                        <td class="actions">
                            <a href="/IgnoredApps/Edit/@app.Id" class="btn btn-secondary btn-sm">Edit</a>
                        </td>
                    </tr>
                }
                @if (!Model.IgnoredApps.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align: center; color: var(--secondary); padding: 2rem;">
                            No ignored apps found. <a href="/IgnoredApps/Create">Add your first ignored app</a>.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card" style="margin-top: 1rem;">
    <div class="card-body">
        <h5>About Ignored Apps</h5>
        <p style="color: var(--secondary); margin-bottom: 0;">
            Ignored apps are system processes that are excluded from application usage tracking. 
            This prevents noise from services like <code>svchost.exe</code>, <code>explorer.exe</code>, and other background processes.
            Changes take effect on client devices after the next configuration sync (typically within 60 seconds).
        </p>
    </div>
</div>
